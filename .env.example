# Copy to .env (or set these however your host expects) and fill in
# real values before deploying anywhere but a local dev machine.
# None of these are read from a .env file automatically — settings.py
# reads them from the real process environment via os.environ.

DJANGO_SECRET_KEY=change-me-to-a-long-random-value
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=example.com,www.example.com

# Set automatically by Render (and most PaaS platforms) when you attach
# a Postgres instance — only set this yourself for a non-Render host.
# Falls back to local SQLite when unset.
# DATABASE_URL=postgres://user:password@host:5432/dbname

STRIPE_PUBLISHABLE_KEY=pk_live_xxx
STRIPE_SECRET_KEY=sk_live_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
