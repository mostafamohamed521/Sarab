# --- Django -----------------------------------------------------------------
# Generate: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me-to-a-long-random-value
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=YOUR-USERNAME.pythonanywhere.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://YOUR-USERNAME.pythonanywhere.com

# --- AI support chat (n8n) --------------------------------------------------
# Production URL of the Webhook node in your n8n workflow.
 DJANGO_DEBUG=True
   N8N_WEBHOOK_URL=https://sarab-support.app.n8n.cloud/webhook-test/sarab-support
   SUPPORT_CHAT_MODE=server

# --- Stripe (optional; on a free PythonAnywhere account outbound calls to Stripe are blocked) ---
STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# --- Optional -----------------------------------------------------------------
# DATABASE_URL=postgres://user:password@host:5432/dbname   # leave unset to use SQLite
# DJANGO_SECURE_SSL_REDIRECT=True
